{% extends "layout.html" %}

{% block title %}Main List - GD Recent Tab List{% endblock %}

{% block content %}

<!-- 🎭 April Fools Easter Egg -->
{% if april_fools_active %}
<div class="alert alert-warning alert-dismissible fade show" role="alert" style="background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4, #feca57); background-size: 400% 400%; animation: gradient 3s ease infinite;">
    <div class="d-flex align-items-center">
        <span style="font-size: 1.2em; margin-right: 10px;">🎭</span>
        <div>
            <strong>Something seems... different today? 🤔</strong><br>
            <small>The levels appear to be having an identity crisis! Refresh the page and watch the magic happen! ✨</small>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<style>
@keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}
</style>
{% endif %}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h4 class="mb-0">📋 Main List</h4>
                    </div>
                    <div class="col-md-6">
                        <form action="{{ url_for('search_levels') }}" method="GET" class="d-flex">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white">🔍</span>
                                <input type="text" name="q" class="form-control" placeholder="Search all levels..." value="{{ request.args.get('q', '') }}">
                                <button class="btn btn-outline-light" type="submit">Search</button>
                                <a href="{{ url_for('advanced_search') }}" class="btn btn-light" title="Advanced Search">
                                    <i class="fas fa-filter"></i>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                {% for level in levels %}
                <div class="d-flex align-items-center p-3 border-bottom level-card mb-4" data-level-id="{{ level._id if level is not mapping else level['_id'] }}" style="cursor: pointer; transition: all 0.2s ease;">
                    <div class="me-4">
                        <div class="position-relative">
                            {% set level_name = level.name if level is not mapping else level['name'] %}
                            {% set video_url = level.video_url if level is not mapping else level.get('video_url', '') %}
                            {% set thumbnail_url = level.thumbnail_url if level is not mapping else level.get('thumbnail_url', '') %}
                            
                            <div class="level-thumbnail" style="width: 206px; height: 116px; position: relative;">
                                {% set level_name = level.name if level is not mapping else level['name'] %}
                                {% set video_url = level.video_url if level is not mapping else level.get('video_url', '') %}
                                {% set thumbnail_url = level.thumbnail_url if level is not mapping else level.get('thumbnail_url', '') %}
                                
                                <!-- OPTIMIZED IMAGE SYSTEM FOR BASE64 -->
                                {% if thumbnail_url and thumbnail_url.strip() %}
                                    {% if thumbnail_url.startswith('data:image') %}
                                        <!-- Base64 image (no error handling needed) -->
                                        <img src="{{ thumbnail_url }}" 
                                             alt="{{ level_name }}" 
                                             class="img-fluid rounded"
                                             style="width: 206px; height: 116px; object-fit: cover;"
                                             loading="lazy">
                                    {% else %}
                                        <!-- External URL image with error handling -->
                                        <img src="{{ thumbnail_url }}" 
                                             alt="{{ level_name }}" 
                                             class="img-fluid rounded"
                                             style="width: 206px; height: 116px; object-fit: cover;"
                                             loading="lazy"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <!-- Fallback for broken external images -->
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" 
                                             style="width: 206px; height: 116px; display: none;">
                                            <div class="text-center">
                                                <i class="fas fa-image fa-2x mb-2"></i>
                                                <div>Image Error</div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <!-- YouTube auto thumbnail -->
                                    {% set youtube_id = '' %}
                                    {% if video_url and video_url.strip() %}
                                        {% if 'youtu.be/' in video_url %}
                                            {% set youtube_id = video_url.split('youtu.be/')[1].split('?')[0].split('&')[0] %}
                                        {% elif 'youtube.com/watch?v=' in video_url %}
                                            {% set youtube_id = video_url.split('v=')[1].split('&')[0] %}
                                        {% endif %}
                                    {% endif %}
                                    
                                    {% if youtube_id %}
                                        <!-- Simple YouTube thumbnail - no complex fallbacks -->
                                        <img src="https://img.youtube.com/vi/{{ youtube_id }}/hqdefault.jpg" 
                                             alt="{{ level_name }}" 
                                             class="img-fluid rounded"
                                             style="width: 206px; height: 116px; object-fit: cover;"
                                             loading="lazy">
                                    {% else %}
                                        <!-- Clean placeholder for no video -->
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" 
                                             style="width: 206px; height: 116px;">
                                            <div class="text-center">
                                                <i class="fas fa-image fa-2x mb-2"></i>
                                                <div>No Preview</div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                            
                            <div class="position-absolute top-0 start-0 bg-dark text-white px-2 py-1 rounded">
                                {{ level.position if level is not mapping else level['position'] }}
                            </div>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="mb-1">{{ level.name if level is not mapping else level['name'] }}</h5>
                        <p class="mb-1 text-muted">by {{ level.creator if level is not mapping else level['creator'] }}</p>
                        <small class="text-muted d-block">verified by {{ level.verifier if level is not mapping else level['verifier'] }}</small>
                        {% if level.level_id %}
                            <small class="text-muted d-block">ID: {{ level.level_id }}</small>
                        {% endif %}
                    </div>
                    <div class="text-end">
                        {% set difficulty = (level.difficulty|default(5.0)|float)|round|int if level is not mapping else (level['difficulty']|default(5.0)|float)|round|int %}
                        {% set demon_type = level.demon_type if level is not mapping else level.get('demon_type') %}
                        <div class="text-muted"><strong>{{ get_difficulty_text(difficulty) }}</strong></div>
                        {% if difficulty == 10 and get_demon_type_display(difficulty, demon_type) %}
                            <div class="text-muted small">{{ get_demon_type_display(difficulty, demon_type) }}</div>
                        {% endif %}
                        {% set position = level.position if level is not mapping else level['position'] %}
                        {% set points = level.points if level is not mapping else level['points'] %}
                        {% set points_num = points|float if points else ((100 - position + 1) / 10)|round(2) %}
                        <small class="text-muted">{{ format_points(points_num) }} points</small>
                    </div>
                </div>
                {% endfor %}
            </div>
            
            <!-- Pagination -->
            {% if total_pages > 1 %}
            <div class="card-footer">
                <nav aria-label="Level pagination">
                    <ul class="pagination justify-content-center mb-0">
                        {% if has_prev %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ prev_page }}">← Previous</a>
                            </li>
                        {% endif %}
                        
                        {% for p in range(1, total_pages + 1) %}
                            {% if p == page %}
                                <li class="page-item active">
                                    <span class="page-link">{{ p }}</span>
                                </li>
                            {% elif p <= 3 or p > total_pages - 3 or (p >= page - 1 and p <= page + 1) %}
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ p }}">{{ p }}</a>
                                </li>
                            {% elif p == 4 and page > 6 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% elif p == total_pages - 3 and page < total_pages - 5 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% endif %}
                        {% endfor %}
                        
                        {% if has_next %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ next_page }}">Next →</a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
                <div class="text-center mt-2">
                    <small class="text-muted">
                        Showing {{ ((page-1) * 10) + 1 }}-{{ ((page-1) * 10) + levels|length }} of {{ total_levels }} levels
                    </small>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0">About</h4>
            </div>
            <div class="card-body">
                <p>Welcome to the GD Recent Tab List! This is a community-driven list that ranks recent tab levels by difficulty.</p>
                <p>Click on any level to view more details, including records and information about the level.</p>
            </div>
        </div>
        

        
        <!-- Enhanced Discord Widget -->
        <div class="card shadow-sm mb-4">
            <div class="discord-widget">
                {% set discord_data = get_discord_data() %}
                <div class="discord-header">
                    <div class="discord-logo">
                        <i class="fab fa-discord"></i>
                    </div>
                    <div class="discord-info">
                        <h4 class="discord-title">{{ discord_data.name }}</h4>
                        <p class="discord-members">{{ discord_data.online_count }} Members Online</p>
                    </div>
                </div>
                
                {% if discord_data.online and discord_data.channels %}
                <!-- Voice Channels -->
                <div class="discord-channels">
                    {% for channel in discord_data.channels[:4] %}
                    <div class="discord-channel">
                        <i class="fas fa-volume-up"></i>
                        <span>{{ channel.name }}</span>
                        <span class="channel-count">
                            {{ discord_data.members | selectattr('channel_id', 'equalto', channel.id) | list | length }}
                        </span>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                
                <!-- Online Members -->
                {% if discord_data.online and discord_data.members %}
                <div class="discord-members-section">
                    <h6 class="members-title">MEMBERS ONLINE</h6>
                    <div class="discord-members-list">
                        {% for member in discord_data.members[:8] %}
                        <div class="discord-member">
                                <div class="member-avatar-placeholder">{{ member.username[0].upper() }}</div>
                            <div class="member-info">
                                <span class="member-name">{{ member.username }}</span>
                                {% if member.channel_name %}
                                    <span class="member-status">🔊 {{ member.channel_name }}</span>
                                {% elif member.game %}
                                    <span class="member-status">🎮 {{ member.game }}</span>
                                {% else %}
                                    <span class="member-status">Online</span>
                                {% endif %}
                            </div>
                            <div class="member-status-indicator status-{{ member.status }}"></div>
                        </div>
                        {% endfor %}
                        {% if discord_data.members | length > 8 %}
                        <div class="more-members">
                            and {{ discord_data.members | length - 8 }} more...
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
                
                <div class="discord-footer">
                    <div class="discord-invite-text">
                        <p>Hangout with people who get it</p>
                    </div>
                    <a href="{{ discord_data.invite_url }}" target="_blank" class="discord-join-btn">
                        Join Discord
                    </a>
                </div>
                
                {% if not discord_data.online %}
                <div class="discord-offline">
                    <p class="text-muted">Discord widget temporarily unavailable</p>
                </div>
                {% endif %}
            </div>
        </div>
        
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Credits</h4>
            </div>
            <div class="card-body">
                <p><strong>List Admin:</strong> Miifin</p>
                <p><strong>List Moderators:</strong> Kye, Monika, ApplePi, DairyFarmer</p>
                <p><strong>List Coder:</strong> ENGINE</p>
                <p><strong>Server Moderator:</strong> Cesium</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    // Add click event to level cards
    document.querySelectorAll('.level-card').forEach(card => {
        card.addEventListener('click', function() {
            const levelId = this.getAttribute('data-level-id');
            window.location = '/level/' + levelId;
        });
    });
    
    // Simple thumbnail system - no complex fallbacks
    

    

</script>
{% endblock %}  
  });
    
    // Auto-refresh Discord widget every 5 minutes
    setInterval(function() {
        fetch('/api/discord_refresh', {method: 'POST'})
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => console.log('Discord refresh failed:', error));
    }, 300000); // 5 minutes
</script>

<style>
/* Discord Widget Styles */
.discord-widget {
    background: linear-gradient(135deg, #5865F2 0%, #4752C4 100%);
    color: white;
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
}

.discord-header {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.1);
}

.discord-logo {
    font-size: 32px;
    margin-right: 12px;
}

.discord-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
}

.discord-members {
    margin: 0;
    font-size: 14px;
    opacity: 0.9;
}

.discord-channels {
    padding: 0 20px;
    margin-bottom: 16px;
}

.discord-channel {
    display: flex;
    align-items: center;
    padding: 4px 0;
    font-size: 14px;
    opacity: 0.8;
}

.discord-channel i {
    margin-right: 8px;
    width: 16px;
}

.channel-count {
    margin-left: auto;
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 12px;
}

.discord-members-section {
    padding: 0 20px;
    margin-bottom: 16px;
}

.members-title {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.7;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

.discord-members-list {
    max-height: 200px;
    overflow-y: auto;
}

.discord-member {
    display: flex;
    align-items: center;
    padding: 4px 0;
    position: relative;
}

.member-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    margin-right: 8px;
}

.member-avatar-placeholder {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #36393f;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    margin-right: 8px;
}

.member-info {
    flex: 1;
    min-width: 0;
}

.member-name {
    font-size: 14px;
    font-weight: 500;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.member-status {
    font-size: 12px;
    opacity: 0.7;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.member-status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-left: 8px;
    flex-shrink: 0;
}

.status-online { background: #3ba55c; }
.status-idle { background: #faa61a; }
.status-dnd { background: #ed4245; }
.status-offline { background: #747f8d; }

.more-members {
    font-size: 12px;
    opacity: 0.7;
    padding: 4px 0;
    text-align: center;
}

.discord-footer {
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.discord-invite-text p {
    margin: 0;
    font-size: 14px;
    opacity: 0.9;
}

.discord-join-btn {
    background: white;
    color: #5865F2;
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s;
}

.discord-join-btn:hover {
    background: #f2f3f5;
    color: #4752C4;
    text-decoration: none;
}

.discord-offline {
    padding: 20px;
    text-align: center;
}

/* Mobile responsive */
@media (max-width: 768px) {
    .discord-header {
        padding: 12px 16px;
    }
    
    .discord-channels,
    .discord-members-section {
        padding: 0 16px;
    }
    
    .discord-footer {
        padding: 12px 16px;
        flex-direction: column;
        gap: 8px;
    }
    
    .discord-members-list {
        max-height: 150px;
    }
}
</style>
{% endblock %}